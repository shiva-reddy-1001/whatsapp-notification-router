# Copy to .env for local development.  Do not commit .env or put real secrets
# in this template.  A judge runner can inject OPENAI_API_KEY directly.

# Provider: auto (default), openai, or ollama. The selected provider is
# preflighted before processing; an unavailable provider fails the run.
ROUTER_LLM_PROVIDER=auto

# OpenAI configuration.  Keep OPENAI_API_KEY unset when using only Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Ollama configuration.  The default endpoint is the standard local service.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Optional, non-secret runtime controls.
ROUTER_DATASET_DIR=dataset
ROUTER_OUTPUT_PATH=output.csv
ROUTER_MEDIA_MODE=auto
ROUTER_REQUEST_TIMEOUT_SECONDS=60
ROUTER_MAX_RETRIES=2
ROUTER_RETRY_MODE=exponential
ROUTER_RETRY_BASE_SECONDS=0.5
ROUTER_RETRY_MAX_SECONDS=8
ROUTER_RETRY_JITTER_SECONDS=0.25
ROUTER_MESSAGE_DEADLINE_SECONDS=180
# 0 disables the whole-run deadline.
ROUTER_RUN_DEADLINE_SECONDS=0
ROUTER_MAX_RETRIEVED_EVIDENCE=5
ROUTER_TEMPERATURE=0
ROUTER_SEED=42
ROUTER_CACHE_PATH=.router-cache/router.sqlite

# Qwen performs semantic image analysis in addition to OCR when enabled.
# auto enables Qwen in local Ollama mode and keeps an OpenAI-only judge run
# independent of local services. Force ollama to combine OpenAI classification
# with local Qwen vision.
ROUTER_VISION_PROVIDER=auto
ROUTER_VISION_MODEL=qwen2.5vl:3b

# Historical texts/media are embedded once and cached in SQLite. `auto` uses
# OpenAI when OPENAI_API_KEY is injected and Ollama otherwise.
ROUTER_EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ROUTER_EMBEDDING_BATCH_SIZE=64

# Local voice-note transcription. `tiny` with int8 keeps local RAM use modest;
# its weights are downloaded and cached only when audio processing is enabled.
ROUTER_AUDIO_TRANSCRIBER=faster_whisper
ROUTER_WHISPER_MODEL=tiny
ROUTER_WHISPER_COMPUTE_TYPE=int8
